postgresDb       = "oficina_db"
postgresUser     = "oficina"
postgresPassword = "troque-esta-senha"
jwtSecret        = "chave-secreta-com-no-minimo-256-bits-de-comprimento"

accessKeyId      = ""
secretAccessKey  = ""
sessionToken     = ""


# Preencha na SEGUNDA execucao, com o valor do output api_public_url.
# Deixar vazio faz os links do e-mail apontarem para localhost.
# appPublicUrl = "http://a1b2c3d4.us-east-1.elb.amazonaws.com:8080"

# Tokens RS256 emitidos pela lambda-token (output jwt_issuer do fiap-lambda).
# Vazio = a API continua validando o HS256 assinado com jwtSecret.
jwtIssuer   = ""
jwtAudience = "fiap-api"

# License key (ingest) da conta New Relic
newrelic_license_key = "sua-license-key-new-relic"

# Conta e User API key (NRAK-...) usadas pelo provider newrelic para criar o
# dashboard. A license key acima só envia dados e não serve aqui.
newrelic_account_id = 1234567
newrelic_api_key    = "NRAK-sua-user-api-key"
# newrelic_region   = "US"
